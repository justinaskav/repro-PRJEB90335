workDir = "_work"
outputDir = "_output"

// Only settings the run reads are listed. Anything left out uses the workflow default.

// Three Novogene NovaSeq 6000 runs (V3-V4), denoised separately with the same settings.
// Reads keep their 8-nt barcode and primer; use_sampleseq trims them per sample.
params.primers = [forward: 'CCTAYGGGRBGCASCAG', reverse: 'GGACTACNNGGGTATCTAAT']
params.batches = ['batch1', 'batch2', 'batch3'].collect { batch ->
    [
        name: batch,
        metadata_path: "./data/metadata/${batch}.tsv",
        input: [
            data_dir: "./data/fastq/${batch}",
            barcode_primer_file: "./data/barcodes/${batch}.tsv",
        ],
        trimming: [enabled: true, use_sampleseq: true, nextseq_trim: 20],
        dada2: [trunc_len_f: 0, trunc_len_r: 0, trim_left_f: 8, max_ee_f: 2, max_ee_r: 2, n_reads_learn: 1000000],
        other: [filter_samples_by_metadata: true],
    ]
}

params.silva = [
    version: '138.2',
    target: 'SSURef_NR99',
    filter_labels: ['Archaea', 'Bacteria', 'Eukaryota'],
    filter_min_lengths: [900, 1200, 1400],
    derep_mode: 'uniq',
]

params.cutadapt = [minimum_length: 100, cpus: 1]

params.host_alignment = [
    enabled: true,
    remove_aligned: true,
    // fetched and SHA-256-checked by scripts/download_data.py (Ensembl release 112)
    host_fasta: "${projectDir}/../data/reference/Homo_sapiens.GRCh38.dna_sm.primary_assembly.fa.gz",
    sensitivity: 'very-sensitive',
]

params.decontam = [method: 'frequency', freq_concentration_column: 'DNA_concentration', threshold: 0.1]

params.taxonomy = [classification_confidence: 0.7]

// Single-threaded FastTree: FastTreeMP gave different trees from the same alignment.
params.phylogeny = [n_threads: 1, mask_max_gap_freq: 1.0, mask_min_conservation: 0.4]

params.r_diversity = [
    seed: 14100715,
    niter: 500,
    alpha: [indices: 'shannon,faith_diversity', names: 'Shannon,Faith_PD'],
    beta: [distance_methods: 'jaccard,bray,unifrac_unweighted,unifrac_weighted', ncomponents: 2],
]

// Exact environments (conda list --explicit): QIIME 2 amplicon 2026.7 and R 4.5. Nextflow builds
// them on the first run; to use existing envs instead pass --qiime2_conda_env / --r_conda_env <path>.
params.qiime2_conda_env = "${projectDir}/../envs/qiime2.lock.txt"
params.r_conda_env = "${projectDir}/../envs/r.lock.txt"

conda.enabled = true

process {
    conda = params.qiime2_conda_env

    withLabel: 'process_medium' {
        cpus = 4
        memory = '8 GB'
    }
    withLabel: 'process_high' {
        cpus = 8
        memory = '32 GB'
    }
    withName: 'RUN_DADA2_PAIRED_END_QIIME2' {
        cpus = 8
        memory = '32 GB'
    }
    withName: 'CREATE_NB_CLASSIFIER' {
        cpus = 4
        memory = '16 GB'
    }
}

trace {
    enabled = true
    file = '_output/reports/trace.txt'
    overwrite = true
}
